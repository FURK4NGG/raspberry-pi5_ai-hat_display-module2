[Unit]
Description=Universal Touchscreen Long Press Right Click
After=multi-user.target

[Service]
Type=simple
User=bob
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/bob/.Xauthority
ExecStart=/usr/bin/python3 /usr/local/bin/touch_right_click.py
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
